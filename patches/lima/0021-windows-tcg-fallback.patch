Subject: [PATCH] qemu: allow an explicit Windows TCG fallback

Keep WHPX as the default Windows accelerator. Users can explicitly enable
software emulation through the Cage Windows TCG setting when WHPX cannot
initialize on their host.

---
 pkg/driver/qemu/qemu.go | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/pkg/driver/qemu/qemu.go b/pkg/driver/qemu/qemu.go
--- a/pkg/driver/qemu/qemu.go
+++ b/pkg/driver/qemu/qemu.go
@@ -1228,4 +1228,8 @@
 			return "nvmm"
 		case "windows":
+			if os.Getenv("CAGE_WINDOWS_TCG") == "1" {
+				logrus.Warn("Windows TCG fallback is enabled by the user; disabling WHPX")
+				return "tcg"
+			}
 			return "whpx"
 		}
